            <column name="sub_image_5" type="blob"/>
            <column name="sub_image_5_content_type" type="string"/>
            <column name="sub_image_6" type="blob"/>
            <column name="sub_image_6_content_type" type="string"/>
            <column name="trip_description" type="clob"/>
            <column name="combined_map" type="string"/>
            <column name="related_events" type="string"/>
            <column name="sub_image_1_description" type="clob"/>
            <column name="sub_image_2_description" type="clob"/>
            <column name="sub_image_3_description" type="clob"/>
            <column name="sub_image_4_description" type="clob"/>
            <column name="sub_image_5_description" type="clob"/>
            <column name="sub_image_6_description" type="clob"/>
            <column name="active_sub_images" type="numeric"/>
            <column name="active_related_events" type="numeric"/>
            <column name="transportation_details" type="clob"/>
            <column name="cost_details" type="clob"/>
            <column name="accomodation_details" type="clob"/>
            <column name="related_links" type="clob"/>
            <column name="start_date" type="date"/>
            <column name="end_date" type="date"/>
