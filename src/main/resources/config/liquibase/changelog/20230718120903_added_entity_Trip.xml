<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity Trip.
    -->
    <changeSet id="20230718120903-1" author="jhipster">
        <createTable tableName="trip">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trip_name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="main_image" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="main_image_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_1" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_1_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_2" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_2_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_3" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_3_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="sub_image_4" type="${blobType}">
                <constraints nullable="true" />
